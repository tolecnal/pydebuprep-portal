# Settings for docker compose: copy to .env and fill in.

# The PostgreSQL password, used by both containers.
POSTGRES_PASSWORD=change-me

# The portal's public URL, as hosts and browsers reach it (https://, behind your proxy).
PORTAL_BASE_URL=https://portal.example.com
# Signs the session cookies: at least 32 random characters (openssl rand -base64 48).
PORTAL_SESSION_SECRET=
# The OIDC provider: for Keycloak, https://KEYCLOAK/realms/REALM
PORTAL_OIDC_ISSUER=https://keycloak.example.com/realms/example
PORTAL_OIDC_CLIENT_ID=pydebuprep-portal
PORTAL_OIDC_CLIENT_SECRET=

# Optional, with their defaults:
# PORTAL_OIDC_GROUPS_CLAIM=groups
# PORTAL_GROUP_PREFIX=pydebuprep-
# Where the portal reads the provider's metadata, when the issuer's public address
# isn't reachable from the container (default: <issuer>/.well-known/openid-configuration).
# PORTAL_OIDC_METADATA_URL=http://keycloak:8080/realms/example/.well-known/openid-configuration
# The audience API access tokens must carry (default: the client id).
# PORTAL_OIDC_AUDIENCE=pydebuprep-portal
# Allows an http:// PORTAL_BASE_URL and non-Secure cookies: for test setups only.
# PORTAL_ALLOW_HTTP=0
# Set by compose from POSTGRES_PASSWORD; each secret may instead be read from a file
# with the _FILE variant (PORTAL_SESSION_SECRET_FILE, ...), for Docker secrets.
# PORTAL_DATABASE_URL=postgresql+psycopg://portal:PASSWORD@db:5432/portal
# The port on 127.0.0.1 compose publishes the portal on.
# PORTAL_PORT=8000
# The proxies whose X-Forwarded-* headers are trusted (uvicorn --forwarded-allow-ips).
# PORTAL_FORWARDED_ALLOW_IPS=127.0.0.1
